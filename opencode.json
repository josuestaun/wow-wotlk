{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "build",
  "permission": {
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git pull": "ask",
      "git pull origin master*": "ask",
      "git pull * master*": "ask",
      "git switch master": "ask",
      "git switch master *": "ask",
      "git checkout master": "ask",
      "git checkout master *": "ask",
      "git push origin master": "ask",
      "git push origin master *": "ask",
      "git push * master": "ask",
      "git push * master *": "ask",
      "git push --tags*": "ask",
      "git push * --tags*": "ask",
      "git push --follow-tags*": "ask",
      "git push * --follow-tags*": "ask",
      "git tag *": "ask",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "git branch -D*": "ask",
      "git push * --delete*": "ask",
      "git push origin --delete feature/*": "allow",
      "git push origin --delete fix/*": "allow",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "git checkout .": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "gh release *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * +*": "deny",
      "git push --mirror*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -*f*": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "build/**",
      "out/**",
      "var/**",
      "env/dist/**",
      "env/user/**",
      "Data/**",
      "backups/**"
    ]
  }
}
