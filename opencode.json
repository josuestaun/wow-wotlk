{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "default_agent": "build",
  "permission": {
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -*f*": "deny",
      "git branch -D*": "ask"
    }
  },
  "watcher": {
    "ignore": [
      "build/**",
      "out/**",
      "var/**",
      "env/dist/**",
      "env/user/**",
      "Data/**",
      "backups/**"
    ]
  }
}
